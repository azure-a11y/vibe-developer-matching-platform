# Orca local runtime state (memory is versioned, scratch is not)
.orca/tmp/
.orca/cache/
# 사람마다 다른 선택입니다 (GitHub 응원 건너뛰기 기록) — 공유하지 않습니다
.orca/state/
wiki/memory/short-term/*.local.md

# Local tooling state — session ids and absolute paths, never shared
.omc/

# Generated images land in the repo, but codex scratch does not
.codex-tmp/

# Scratch working copies left by deploy/agent tooling — full repo clones with
# their own .env.local/.vercel/.claude state, never meant to be tracked.
.tmp-admin-*/

# Admin account passwordHash values are credentials, not content — never commit
content/admin-accounts/

# Session log dumps (work-log-compact-*.md) run tens of MB each — local only.
# Small dated notes already tracked here (work-log-2026-08-04.md 등) stay
# tracked; this only stops new large dumps from being added by accident.
docs/work-log/

# Local reference checkout of an external project (never tracked in this
# repo's history) — overlaps heavily with artifact/ai-builder-group/, which
# is the actual tracked copy.
reference/
.vercel
.env*
