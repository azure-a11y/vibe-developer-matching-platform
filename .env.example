# ─────────────────────────────────────────────────────────────
# Orca AI Company — environment template
# Copy to `.env` (repo root). Apps read it through turbo globalEnv.
#
# 모든 값은 선택입니다. 비워두면 해당 기능만 꺼지고 앱은 정상 동작합니다.
# ─────────────────────────────────────────────────────────────

# ── 사이트 기본 ───────────────────────────────────────────────
# canonical · sitemap · OG 태그에 쓰입니다. 배포 시 실제 도메인으로 바꾸세요.
# 공백이 들어간 값은 반드시 따옴표로 감싸세요 — 셸 문법으로 읽힙니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Orca Blog"
NEXT_PUBLIC_SITE_DESCRIPTION="AI 에이전트 팀이 기획하고, 검수하고, 발행하는 블로그."
NEXT_PUBLIC_SITE_LOCALE=ko-KR

# 앱 포트. 다른 프로젝트와 충돌하면 여기서 바꾸세요.
WEB_PORT=3000
ADMIN_PORT=3001

# ── 콘텐츠 저장소 ─────────────────────────────────────────────
# 마크다운 콘텐츠 루트 (레포 루트 기준).
CONTENT_DIR=content

# 드라이버 강제 지정: file | supabase
# 비워두면 Supabase 키 유무로 자동 선택됩니다. 이관 중에 유용합니다.
# CONTENT_DRIVER=file

# ── Supabase (비워두면 파일 기반으로 동작) ────────────────────
# 채우고 packages/supabase/migrations 를 적용하면 자동으로 전환됩니다.
# 절차: packages/supabase/migrations/README.md
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# 서버 전용. 절대 클라이언트에 노출하지 마세요 (RLS 를 우회합니다).
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
# 이미지 업로드 버킷 (마이그레이션이 만들어 줍니다).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=post-images

# ── 검색엔진 소유 확인 ────────────────────────────────────────
# Google Search Console → 설정 → 소유권 확인 → HTML 태그의 content 값
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 → 웹마스터 도구 → 사이트 등록 → HTML 태그의 content 값
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Bing Webmaster Tools → msvalidate.01 의 content 값
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── 애널리틱스 ────────────────────────────────────────────────
# GA4 측정 ID. 비워두면 트래커가 아예 로드되지 않습니다.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── 소셜 ──────────────────────────────────────────────────────
# twitter:site 기본값. 글별로 어드민에서 덮어쓸 수 있습니다.
# NEXT_PUBLIC_TWITTER_SITE=@your_handle

# ── 문의(pluug) ───────────────────────────────────────────────
# admin Inquiry 화면의 "pluug 문의 관리 열기" 버튼이 여는 URL. 정식 pluug 관리
# 화면 주소가 아직 확정되지 않았습니다(PRD §8 Q7/Q20) — 비워두면 TBD로 표시됩니다.
# PLUUG_ADMIN_URL=

# ── 관리자 인증 (docs/project/04_정책정의.md §4) ──────────────
# 세션 쿠키 서명 키. 반드시 배포 전 무작위 문자열로 바꾸세요 — 비워두면 로컬
# 데모용 고정값을 쓰며, 이 상태로 배포하지 마세요.
# ADMIN_SESSION_SECRET=

# 최초 관리자 계정 부트스트랩(관리자 계정이 하나도 없을 때만 동작). 둘 다 채워야
# 로그인 화면에서 이 자격증명으로 최초 1회 로그인 시 최종 관리자 계정이
# 자동 생성됩니다. 계정이 생기면 이 값은 더 이상 쓰이지 않습니다.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# ── 이미지 생성 ───────────────────────────────────────────────
# HARD RULE: 이미지 생성은 Codex `imagegen` 전용입니다.
# Claude 가 이미지를 만드는 것은 금지되어 있습니다. CLAUDE.md § Image Policy 참조.
IMAGE_PROVIDER=codex
IMAGE_OUTPUT_DIR=apps/web/public/images/posts
# Codex 부재 시 폴백: none | user | websearch
IMAGE_FALLBACK=user
# Codex CLI 의 호출 방식이 다를 때 덮어쓰기 ({out} 과 {prompt} 가 치환됩니다)
# CODEX_IMAGEGEN_CMD=codex imagegen --out {out} "{prompt}"
